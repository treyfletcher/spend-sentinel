{
  "instances": {
    "i-web": {
      "instance_type": "t3.medium",
      "tags": {
        "Name": "web"
      }
    }
  },
  "security_groups": {
    "sg-app": {
      "ingress": [
        {
          "protocol": "tcp",
          "from_port": 80,
          "to_port": 80,
          "cidr_blocks": [
            "192.168.0.0/16"
          ]
        },
        {
          "protocol": "tcp",
          "from_port": 80,
          "to_port": 80,
          "cidr_blocks": [
            "10.0.0.0/8"
          ]
        },
        {
          "protocol": "tcp",
          "from_port": 443,
          "to_port": 443,
          "cidr_blocks": [
            "0.0.0.0/0"
          ]
        }
      ],
      "egress": [
        {
          "protocol": "-1",
          "from_port": 0,
          "to_port": 0,
          "cidr_blocks": [
            "0.0.0.0/0"
          ],
          "ipv6_cidr_blocks": [
            "::/0"
          ]
        }
      ]
    }
  },
  "buckets": {
    "bucket-logs": {
      "tags": {
        "Team": "core"
      },
      "versioning_enabled": false
    }
  },
  "errors": {
    "i-err": "AuthFailure: not authorized to perform ec2:DescribeInstances"
  }
